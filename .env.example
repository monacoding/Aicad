# Copy to .env and fill in. The server reads these; the browser never sees the key.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the API host (e.g. a gateway). The SDK respects this.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional: model used for natural-language parsing. Defaults to claude-opus-4-8.
AICAD_MODEL=claude-opus-4-8
PORT=8787
