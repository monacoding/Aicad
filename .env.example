# Copy to .env and fill in. The server reads these; the browser never sees them.
#
# Natural-language drawing backend is chosen automatically:
#   1) local Claude Code CLI (no key needed — just have `claude` logged in)
#   2) ANTHROPIC_API_KEY below
#   3) built-in local interpreter (offline fallback)
#
# --- Option A: use the local Claude CLI (recommended, no API key) -------------
# Nothing required if `claude` is on your PATH and logged in.
# AICAD_CLAUDE_CLI=claude        # path to the claude binary, if not on PATH
# AICAD_PROVIDER=cli             # force CLI even if an API key is present
#
# --- Option B: use an API key -------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=http://localhost:8082   # optional local gateway/proxy
#
# --- common -------------------------------------------------------------------
AICAD_MODEL=claude-opus-4-8
PORT=8787
